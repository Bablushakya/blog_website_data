<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection' expr:lang='data:blog.locale' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta charset='utf-8'/>
  <meta content='width=device-width, initial-scale=1, maximum-scale=1' name='viewport'/>
  <b:include data='blog' name='all-head-content'/>
  <title><data:blog.pageTitle/></title>

  <b:skin><![CDATA[
    /* ========================================
       TRAVEL INDIAS HERITAGE - CUSTOM THEME
       Heritage Travel Blog Theme
       ======================================== */

    /* ----- RESET & BASE ----- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
      background: #faf8f5;
      color: #2d2a24;
      line-height: 1.7;
    }

    a {
      color: #b8860b;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    a:hover {
      color: #8b6914;
      text-decoration: underline;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* ----- HEADER ----- */
    .site-header {
      background: #1a1a1a;
      padding: 18px 0;
      border-bottom: 4px solid #b8860b;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 2px 15px rgba(0,0,0,0.3);
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }

    .site-title {
      font-size: 28px;
      font-weight: 700;
      color: #f5e6c8;
      letter-spacing: 1px;
    }

    .site-title a {
      color: #f5e6c8;
      text-decoration: none;
    }

    .site-title a:hover {
      color: #b8860b;
      text-decoration: none;
    }

    .site-title .highlight {
      color: #b8860b;
    }

    .site-desc {
      font-size: 14px;
      color: #a09080;
      margin-top: 2px;
      font-weight: 300;
    }

    /* ----- NAVIGATION ----- */
    .main-nav {
      display: flex;
      gap: 5px;
      flex-wrap: wrap;
    }

    .main-nav a {
      color: #e0d5c5;
      padding: 8px 16px;
      font-size: 15px;
      font-weight: 500;
      border-radius: 4px;
      transition: all 0.3s ease;
      text-decoration: none;
    }

    .main-nav a:hover {
      background: #b8860b;
      color: #fff;
      text-decoration: none;
    }

    .main-nav .current {
      background: #b8860b;
      color: #fff;
    }

    /* ----- MOBILE NAV TOGGLE ----- */
    .nav-toggle {
      display: none;
      background: none;
      border: 2px solid #b8860b;
      color: #f5e6c8;
      font-size: 24px;
      padding: 6px 14px;
      border-radius: 4px;
      cursor: pointer;
    }

    /* ----- HERO SECTION ----- */
    .hero {
      background: linear-gradient(135deg, #1a1a1a 0%, #2d2a24 50%, #1a1a1a 100%);
      padding: 70px 20px 60px;
      text-align: center;
      border-bottom: 4px solid #b8860b;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" opacity="0.05"><path d="M20,20 L80,20 L80,80 L20,80 Z" stroke="%23b8860b" stroke-width="0.5" fill="none"/><path d="M35,35 L65,35 L65,65 L35,65 Z" stroke="%23b8860b" stroke-width="0.5" fill="none"/><circle cx="50" cy="50" r="12" stroke="%23b8860b" stroke-width="0.5" fill="none"/></svg>') repeat;
      background-size: 120px 120px;
    }

    .hero h1 {
      font-size: 48px;
      font-weight: 700;
      color: #f5e6c8;
      position: relative;
      z-index: 1;
    }

    .hero h1 .highlight {
      color: #b8860b;
    }

    .hero p {
      font-size: 20px;
      color: #c0b5a5;
      max-width: 700px;
      margin: 20px auto 30px;
      position: relative;
      z-index: 1;
    }

    .hero .btn {
      display: inline-block;
      background: #b8860b;
      color: #fff;
      padding: 14px 40px;
      border-radius: 50px;
      font-weight: 600;
      font-size: 18px;
      text-decoration: none;
      transition: all 0.3s ease;
      position: relative;
      z-index: 1;
      border: none;
      cursor: pointer;
    }

    .hero .btn:hover {
      background: #9a7009;
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(184, 134, 11, 0.4);
      text-decoration: none;
    }

    /* ----- MAIN CONTENT LAYOUT ----- */
    .main-wrapper {
      display: flex;
      gap: 40px;
      padding: 40px 0;
      flex-wrap: wrap;
    }

    .content-main {
      flex: 1;
      min-width: 300px;
    }

    .sidebar-main {
      width: 320px;
      flex-shrink: 0;
    }

    /* ----- POST CARDS ----- */
    .post-card {
      background: #fff;
      border-radius: 12px;
      padding: 30px;
      margin-bottom: 30px;
      box-shadow: 0 2px 20px rgba(0,0,0,0.06);
      border-left: 4px solid #b8860b;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .post-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 35px rgba(0,0,0,0.10);
    }

    .post-card .post-title {
      font-size: 26px;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 10px;
    }

    .post-card .post-title a {
      color: #1a1a1a;
      text-decoration: none;
    }

    .post-card .post-title a:hover {
      color: #b8860b;
      text-decoration: none;
    }

    .post-card .post-meta {
      font-size: 14px;
      color: #999;
      margin-bottom: 15px;
      border-bottom: 1px solid #eee;
      padding-bottom: 12px;
    }

    .post-card .post-meta .label {
      background: #f0ebe3;
      padding: 2px 12px;
      border-radius: 20px;
      font-size: 12px;
      color: #8b6914;
      margin-right: 5px;
    }

    .post-card .post-snippet {
      color: #555;
      font-size: 16px;
      line-height: 1.8;
    }

    .post-card .read-more {
      display: inline-block;
      margin-top: 15px;
      color: #b8860b;
      font-weight: 600;
      text-decoration: none;
    }

    .post-card .read-more:hover {
      color: #8b6914;
      text-decoration: underline;
    }

    .post-card .post-thumb {
      width: 100%;
      height: 220px;
      object-fit: cover;
      border-radius: 8px;
      margin-bottom: 16px;
      background: #e8e0d6;
    }

    /* ----- FEATURED GRID (Homepage) ----- */
    .featured-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
      margin: 30px 0 40px;
    }

    .featured-item {
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 15px rgba(0,0,0,0.06);
      transition: transform 0.3s ease;
    }

    .featured-item:hover {
      transform: translateY(-6px);
    }

    .featured-item img {
      width: 100%;
      height: 180px;
      object-fit: cover;
      display: block;
    }

    .featured-item .info {
      padding: 18px 20px 20px;
    }

    .featured-item .info h3 {
      font-size: 18px;
      font-weight: 600;
      color: #1a1a1a;
    }

    .featured-item .info h3 a {
      color: #1a1a1a;
      text-decoration: none;
    }

    .featured-item .info h3 a:hover {
      color: #b8860b;
      text-decoration: none;
    }

    .featured-item .info p {
      font-size: 14px;
      color: #777;
      margin-top: 6px;
    }

    /* ----- SECTION TITLES ----- */
    .section-title {
      font-size: 28px;
      font-weight: 700;
      color: #1a1a1a;
      margin: 30px 0 20px;
      padding-bottom: 12px;
      border-bottom: 3px solid #b8860b;
      display: inline-block;
    }

    .section-title .highlight {
      color: #b8860b;
    }

    /* ----- SIDEBAR ----- */
    .sidebar-main .widget {
      background: #fff;
      border-radius: 12px;
      padding: 24px 22px;
      margin-bottom: 25px;
      box-shadow: 0 2px 15px rgba(0,0,0,0.05);
      border-left: 4px solid #b8860b;
    }

    .sidebar-main .widget h2 {
      font-size: 20px;
      font-weight: 700;
      color: #1a1a1a;
      margin-bottom: 15px;
      padding-bottom: 10px;
      border-bottom: 2px solid #f0ebe3;
    }

    .sidebar-main .widget ul {
      list-style: none;
    }

    .sidebar-main .widget ul li {
      padding: 8px 0;
      border-bottom: 1px solid #f5f0ea;
    }

    .sidebar-main .widget ul li:last-child {
      border-bottom: none;
    }

    .sidebar-main .widget ul li a {
      color: #444;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .sidebar-main .widget ul li a:hover {
      color: #b8860b;
      text-decoration: none;
    }

    /* Search box */
    .sidebar-main .BlogSearch input[type="text"] {
      width: 100%;
      padding: 12px 16px;
      border: 2px solid #e0d5c5;
      border-radius: 8px;
      font-size: 15px;
      background: #faf8f5;
      transition: border 0.3s ease;
    }

    .sidebar-main .BlogSearch input[type="text"]:focus {
      border-color: #b8860b;
      outline: none;
    }

    .sidebar-main .BlogSearch input[type="submit"] {
      background: #b8860b;
      color: #fff;
      border: none;
      padding: 12px 24px;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      margin-top: 10px;
      transition: background 0.3s ease;
    }

    .sidebar-main .BlogSearch input[type="submit"]:hover {
      background: #9a7009;
    }

    /* Profile widget */
    .sidebar-main .Profile .profile-img {
      border-radius: 50%;
      border: 3px solid #b8860b;
    }

    /* ----- FOOTER ----- */
    .site-footer {
      background: #1a1a1a;
      color: #a09080;
      padding: 40px 0 20px;
      border-top: 4px solid #b8860b;
      margin-top: 30px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 30px;
      margin-bottom: 30px;
    }

    .footer-grid h3 {
      color: #f5e6c8;
      font-size: 18px;
      margin-bottom: 15px;
      padding-bottom: 8px;
      border-bottom: 2px solid #b8860b;
      display: inline-block;
    }

    .footer-grid ul {
      list-style: none;
    }

    .footer-grid ul li {
      padding: 5px 0;
    }

    .footer-grid ul li a {
      color: #a09080;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .footer-grid ul li a:hover {
      color: #b8860b;
      text-decoration: none;
    }

    .footer-bottom {
      text-align: center;
      padding-top: 20px;
      border-top: 1px solid #333;
      font-size: 14px;
      color: #666;
    }

    .footer-bottom a {
      color: #b8860b;
      text-decoration: none;
    }

    /* ----- RESPONSIVE ----- */
    @media screen and (max-width: 768px) {
      .header-inner {
        flex-direction: column;
        align-items: flex-start;
      }

      .nav-toggle {
        display: block;
        position: absolute;
        top: 20px;
        right: 20px;
      }

      .main-nav {
        display: none;
        width: 100%;
        flex-direction: column;
        margin-top: 15px;
        gap: 2px;
      }

      .main-nav.open {
        display: flex;
      }

      .main-nav a {
        padding: 12px 16px;
        width: 100%;
        border-bottom: 1px solid #333;
      }

      .hero h1 {
        font-size: 32px;
      }

      .hero p {
        font-size: 17px;
      }

      .main-wrapper {
        flex-direction: column;
      }

      .sidebar-main {
        width: 100%;
      }

      .post-card .post-title {
        font-size: 22px;
      }

      .featured-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media screen and (max-width: 480px) {
      .featured-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        padding: 40px 15px 35px;
      }

      .hero h1 {
        font-size: 26px;
      }

      .site-title {
        font-size: 22px;
      }
    }

    /* ----- BLOGGER NATIVE WIDGET OVERRIDES ----- */
    .blog-posts {
      margin: 0;
    }

    .date-outer {
      margin-bottom: 30px;
    }

    .date-header {
      font-size: 14px;
      color: #999;
      margin-bottom: 8px;
      font-weight: 500;
    }

    .post-footer {
      margin-top: 15px;
      padding-top: 12px;
      border-top: 1px solid #eee;
      font-size: 14px;
      color: #999;
    }

    /* Pagination */
    .blog-pager {
      text-align: center;
      padding: 20px 0;
      font-size: 16px;
    }

    .blog-pager a {
      color: #b8860b;
      font-weight: 600;
      padding: 8px 20px;
      border: 2px solid #b8860b;
      border-radius: 30px;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-block;
      margin: 0 5px;
    }

    .blog-pager a:hover {
      background: #b8860b;
      color: #fff;
      text-decoration: none;
    }

    /* Comments */
    #comments {
      background: #fff;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 2px 15px rgba(0,0,0,0.05);
      margin-top: 25px;
    }

    #comments h4 {
      font-size: 22px;
      color: #1a1a1a;
      margin-bottom: 15px;
    }

    /* Image responsive */
    .post-body img {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
    }

    /* Breadcrumb style */
    .breadcrumb {
      font-size: 14px;
      color: #999;
      margin-bottom: 15px;
    }

    .breadcrumb a {
      color: #b8860b;
      text-decoration: none;
    }

    .breadcrumb a:hover {
      text-decoration: underline;
    }

    /* Label cloud style */
    .label-size {
      display: inline-block;
      background: #f0ebe3;
      padding: 4px 14px;
      border-radius: 20px;
      font-size: 13px;
      margin: 3px 4px 3px 0;
      transition: all 0.3s ease;
    }

    .label-size a {
      color: #555;
      text-decoration: none;
    }

    .label-size:hover {
      background: #b8860b;
    }

    .label-size:hover a {
      color: #fff;
      text-decoration: none;
    }
  ]]></b:skin>

  <b:template-skin>
    <b:variable default='1200px' name='content.width' type='length'/>
    <b:variable default='0' name='main.column.left.width' type='length'/>
    <b:variable default='0' name='main.column.right.width' type='length'/>
    <![CDATA[
      body { min-width: 300px; }
      .content-outer, .content-fauxcolumn-outer, .region-inner {
        min-width: 300px;
        max-width: 100%;
        width: auto;
      }
      .main-inner .columns { padding: 0; }
      .main-inner .fauxcolumn-center-outer {
        left: 0;
        right: 0;
        width: 100%;
      }
      #layout { min-width: 0; }
      #layout .content-outer { min-width: 0; width: 800px; }
      #layout .region-inner { min-width: 0; width: auto; }
    ]]>
  </b:template-skin>

  <b:include data='blog' name='google-analytics'/>
</head>

<body expr:class='&quot;loading&quot; + data:blog.mobileClass'>
  <b:section class='navbar' id='navbar' maxwidgets='1' name='Navbar' showaddelement='no'>
    <b:widget id='Navbar1' locked='true' title='Navbar' type='Navbar'>
      <b:includable id='main'>
        <script type='text/javascript'>
          function setAttributeOnload(object, attribute, val) {
            if(window.addEventListener) {
              window.addEventListener('load',
                function(){ object[attribute] = val; }, false);
            } else {
              window.attachEvent('onload', function(){ object[attribute] = val; });
            }
          }
        </script>
        <div id='navbar-iframe-container'></div>
        <script type='text/javascript' src='https://apis.google.com/js/platform.js'></script>
        <script type='text/javascript'>
          gapi.load("gapi.iframes:gapi.iframes.style.bubble", function() {
            if (gapi.iframes && gapi.iframes.getContext) {
              gapi.iframes.getContext().openChild({
                url: 'https://www.blogger.com/navbar/3627582483560618663?origin\x3dhttp://localhost:80',
                where: document.getElementById("navbar-iframe-container"),
                id: "navbar-iframe"
              });
            }
          });
        </script>
      </b:includable>
    </b:widget>
  </b:section>

  <b:if cond='data:blog.pageType == "index"'>
    <div itemscope='itemscope' itemtype='http://schema.org/Blog' style='display: none;'>
      <meta expr:content='data:blog.title' itemprop='name'/>
      <b:if cond='data:blog.metaDescription'>
        <meta expr:content='data:blog.metaDescription' itemprop='description'/>
      </b:if>
    </div>
  </b:if>

  <!-- ====== HEADER ====== -->
  <header class='site-header'>
    <div class='container header-inner'>
      <div>
        <div class='site-title'>
          <a href='/'><span class='highlight'>&#127963;</span> Travel <span class='highlight'>Indias</span> Heritage</a>
        </div>
        <div class='site-desc'><data:blog.description/></div>
      </div>
      <button class='nav-toggle' onclick='document.querySelector(".main-nav").classList.toggle("open")'>&#9776;</button>
      <nav class='main-nav'>
        <a href='/' class='current'>Home</a>
        <a href='#'>Destinations</a>
        <a href='#'>Heritage</a>
        <a href='#'>Travel Guides</a>
        <a href='#'>Things to Do</a>
        <a href='#'>Culture</a>
        <a href='#'>About</a>
        <a href='#'>Contact</a>
      </nav>
    </div>
  </header>

  <!-- ====== HERO SECTION ====== -->
  <section class='hero'>
    <div class='container'>
      <h1>Discover <span class='highlight'>India's</span> Rich Heritage</h1>
      <p>Explore historic forts, majestic palaces, sacred temples, vibrant festivals, and authentic travel experiences across Incredible India.</p>
      <a class='btn' href='#'>Explore Destinations &#8594;</a>
    </div>
  </section>

  <!-- ====== MAIN CONTENT ====== -->
  <div class='container main-wrapper'>
    <main class='content-main'>
      <div class='featured-grid'>
        <div class='featured-item'>
          <img alt='Rajasthan Forts' src='https://images.unsplash.com/photo-1587474260584-136574528ed5?w=600&amp;h=400&amp;fit=crop'/>
          <div class='info'>
            <h3><a href='#'>Rajasthan: Land of Kings</a></h3>
            <p>Explore the majestic forts and palaces of Rajasthan.</p>
          </div>
        </div>
        <div class='featured-item'>
          <img alt='Taj Mahal' src='https://images.unsplash.com/photo-1564507592333-c60657eea523?w=600&amp;h=400&amp;fit=crop'/>
          <div class='info'>
            <h3><a href='#'>Agra &amp; The Taj Mahal</a></h3>
            <p>Discover the timeless beauty of the Taj Mahal.</p>
          </div>
        </div>
        <div class='featured-item'>
          <img alt='Kerala Backwaters' src='https://images.unsplash.com/photo-1593693397690-362cb9666fc2?w=600&amp;h=400&amp;fit=crop'/>
          <div class='info'>
            <h3><a href='#'>Kerala: God's Own Country</a></h3>
            <p>Backwaters, beaches, and lush green landscapes.</p>
          </div>
        </div>
      </div>

      <h2 class='section-title'>Latest <span class='highlight'>Travel Guides</span></h2>

      <!-- BLOGGER POSTS LOOP -->
      <b:section class='main' id='main' name='Main' showaddelement='no'>
        <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog'>
          <b:widget-settings>
            <b:widget-setting name='showDateHeader'>true</b:widget-setting>
            <b:widget-setting name='showShareButtons'>true</b:widget-setting>
            <b:widget-setting name='authorLabel'>By</b:widget-setting>
            <b:widget-setting name='showCommentLink'>true</b:widget-setting>
            <b:widget-setting name='showAuthor'>true</b:widget-setting>
            <b:widget-setting name='showLabels'>true</b:widget-setting>
            <b:widget-setting name='showLocation'>true</b:widget-setting>
            <b:widget-setting name='showTimestamp'>true</b:widget-setting>
            <b:widget-setting name='showBacklinks'>false</b:widget-setting>
            <b:widget-setting name='showInlineAds'>false</b:widget-setting>
            <b:widget-setting name='showReactions'>false</b:widget-setting>
          </b:widget-settings>

          <b:includable id='main' var='top'>
            <b:if cond='!data:mobile'>
              <div class='blog-posts hfeed'>
                <b:include data='top' name='status-message'/>
                <b:loop values='data:posts' var='post'>
                  <b:if cond='data:post.isDateStart and not data:post.isFirstPost'>
                    </div></div>
                  </b:if>
                  <b:if cond='data:post.isDateStart'>
                    <div class='date-outer'>
                  </b:if>
                  <b:if cond='data:post.dateHeader'>
                    <h2 class='date-header'><span><data:post.dateHeader/></span></h2>
                  </b:if>
                  <b:if cond='data:post.isDateStart'>
                    <div class='date-posts'>
                  </b:if>
                  <div class='post-outer'>
                    <b:include data='post' name='post'/>
                    <b:include cond='data:blog.pageType in {"static_page","item"}' data='post' name='comment_picker'/>
                  </div>
                </b:loop>
                <b:if cond='data:numPosts != 0'>
                  </div></div>
                </b:if>
              </div>
              <b:include name='nextprev'/>
              <b:include name='feedLinks'/>
            <b:else/>
              <b:include name='mobile-main'/>
            </b:if>
          </b:includable>

          <b:includable id='post' var='post'>
            <div class='post-card hentry' itemprop='blogPost' itemscope='itemscope' itemtype='http://schema.org/BlogPosting'>
              <b:if cond='data:post.firstImageUrl'>
                <meta expr:content='data:post.firstImageUrl' itemprop='image_url'/>
              </b:if>
              <meta expr:content='data:blog.blogId' itemprop='blogId'/>
              <meta expr:content='data:post.id' itemprop='postId'/>
              <a expr:name='data:post.id'/>

              <b:if cond='data:post.thumbnailUrl'>
                <img class='post-thumb' expr:alt='data:post.title' expr:src='data:post.thumbnailUrl'/>
              </b:if>

              <b:if cond='data:post.title'>
                <h3 class='post-title entry-title' itemprop='name'>
                  <b:if cond='data:post.link or (data:post.url and data:blog.url != data:post.url)'>
                    <a expr:href='data:post.link ? data:post.link : data:post.url'><data:post.title/></a>
                  <b:else/>
                    <data:post.title/>
                  </b:if>
                </h3>
              </b:if>

              <div class='post-meta'>
                <span class='post-author'>
                  <b:if cond='data:top.showAuthor'>
                    <data:top.authorLabel/>
                    <b:if cond='data:post.authorProfileUrl'>
                      <a expr:href='data:post.authorProfileUrl' rel='author'><data:post.author/></a>
                    <b:else/>
                      <data:post.author/>
                    </b:if>
                  </b:if>
                </span>
                <span class='post-timestamp'>
                  <b:if cond='data:top.showTimestamp'>
                    <data:top.timestampLabel/>
                    <b:if cond='data:post.url'>
                      <a class='timestamp-link' expr:href='data:post.url' rel='bookmark' title='permanent link'>
                        <abbr class='published' expr:title='data:post.timestampISO8601' itemprop='datePublished'><data:post.timestamp/></abbr>
                      </a>
                    </b:if>
                  </b:if>
                </span>
                <b:if cond='data:post.labels'>
                  <span>
                    <b:loop values='data:post.labels' var='label'>
                      <span class='label'><a expr:href='data:label.url' rel='tag'><data:label.name/></a></span>
                    </b:loop>
                  </span>
                </b:if>
              </div>

              <div class='post-body entry-content' expr:id='&quot;post-body-&quot; + data:post.id' expr:itemprop='(data:blog.metaDescription ? "" : "description ") + "articleBody"'>
                <data:post.snippet/>
                <div style='clear: both;'/>
              </div>

              <b:if cond='data:post.hasJumpLink'>
                <div class='jump-link'>
                  <a class='read-more' expr:href='data:post.url + "#more"' expr:title='data:post.title'>Read More &#8594;</a>
                </div>
              </b:if>

              <div class='post-footer'>
                <div class='post-footer-line post-footer-line-1'>
                  <span class='post-comment-link'>
                    <b:include cond='data:blog.pageType not in {"item","static_page"} and data:post.allowComments' data='post' name='comment_count_picker'/>
                  </span>
                  <b:include data='post' name='postQuickEdit'/>
                </div>
              </div>
            </div>
          </b:includable>

          <b:includable id='comment_count_picker' var='post'>
            <a class='comment-link' expr:href='data:post.addCommentUrl' expr:onclick='data:post.addCommentOnclick'>
              <data:post.commentLabelFull/>
            </a>
          </b:includable>

          <b:includable id='comment_picker' var='post'>
            <b:if cond='data:post.showThreadedComments'>
              <b:include data='post' name='threaded_comments'/>
            <b:else/>
              <b:include data='post' name='comments'/>
            </b:if>
          </b:includable>

          <b:includable id='threaded_comments' var='post'>
            <div class='comments' id='comments'>
              <a name='comments'/>
              <h4><data:post.commentLabelFull/>:</h4>
              <div class='comments-content'>
                <div id='comment-holder'>
                  <data:post.commentHtml/>
                </div>
              </div>
              <p class='comment-footer'>
                <b:if cond='data:post.allowNewComments'>
                  <b:include data='post' name='threaded-comment-form'/>
                <b:else/>
                  <data:post.noNewCommentsText/>
                </b:if>
              </p>
            </div>
          </b:includable>

          <b:includable id='threaded-comment-form' var='post'>
            <div class='comment-form'>
              <a name='comment-form'/>
              <p><data:blogCommentMessage/></p>
              <data:blogTeamBlogMessage/>
              <a expr:href='data:post.commentFormIframeSrc' id='comment-editor-src'/>
              <iframe allowtransparency='true' class='blogger-iframe-colorize blogger-comment-from-post' expr:height='data:cmtIframeInitialHeight' frameborder='0' id='comment-editor' name='comment-editor' src='' width='100%'/>
              <data:post.cmtfpIframe/>
              <script type='text/javascript'>
                BLOG_CMT_createIframe('<data:post.appRpcRelayPath/>');
              </script>
            </div>
          </b:includable>

          <b:includable id='comments' var='post'>
            <div class='comments' id='comments'>
              <a name='comments'/>
              <h4><data:post.commentLabelFull/>:</h4>
              <b:if cond='data:post.allowComments'>
                <div expr:id='data:widget.instanceId + "_comments-block-wrapper"'>
                  <dl expr:class='data:post.avatarIndentClass' id='comments-block'>
                    <b:loop values='data:post.comments' var='comment'>
                      <dt expr:class='&quot;comment-author &quot; + data:comment.authorClass' expr:id='data:comment.anchorName'>
                        <a expr:name='data:comment.anchorName'/>
                        <b:if cond='data:blog.enabledCommentProfileImages'>
                          <data:comment.authorAvatarImage/>
                        </b:if>
                        <b:if cond='data:comment.authorUrl'>
                          <a expr:href='data:comment.authorUrl' rel='nofollow'><data:comment.author/></a>
                        <b:else/>
                          <data:comment.author/>
                        </b:if>
                      </dt>
                      <dd class='comment-body' expr:id='data:widget.instanceId + data:comment.cmtBodyIdPostfix'>
                        <p><data:comment.body/></p>
                      </dd>
                    </b:loop>
                  </dl>
                </div>
                <p class='comment-footer'>
                  <b:if cond='data:post.embedCommentForm'>
                    <b:if cond='data:post.allowNewComments'>
                      <b:include data='post' name='comment-form'/>
                    <b:else/>
                      <data:post.noNewCommentsText/>
                    </b:if>
                  <b:elseif cond='data:post.allowComments'/>
                    <a expr:href='data:post.addCommentUrl' expr:onclick='data:post.addCommentOnclick'><data:postCommentMsg/></a>
                  </b:if>
                </p>
              </b:if>
            </div>
          </b:includable>

          <b:includable id='comment-form' var='post'>
            <div class='comment-form'>
              <a name='comment-form'/>
              <h4 id='comment-post-message'><data:postCommentMsg/></h4>
              <p><data:blogCommentMessage/></p>
              <data:blogTeamBlogMessage/>
              <a expr:href='data:post.commentFormIframeSrc' id='comment-editor-src'/>
              <iframe allowtransparency='true' class='blogger-iframe-colorize blogger-comment-from-post' expr:height='data:cmtIframeInitialHeight' frameborder='0' id='comment-editor' name='comment-editor' src='' width='100%'/>
              <data:post.cmtfpIframe/>
              <script type='text/javascript'>
                BLOG_CMT_createIframe('<data:post.appRpcRelayPath/>');
              </script>
            </div>
          </b:includable>

          <b:includable id='postQuickEdit' var='post'>
            <b:if cond='data:post.editUrl'>
              <span expr:class='&quot;item-control &quot; + data:post.adminClass'>
                <a expr:href='data:post.editUrl' expr:title='data:top.editPostMsg'>
                  <img alt='' class='icon-action' height='18' src='https://resources.blogblog.com/img/icon18_edit_allbkg.gif' width='18'/>
                </a>
              </span>
            </b:if>
          </b:includable>

          <b:includable id='nextprev'>
            <div class='blog-pager' id='blog-pager'>
              <b:if cond='data:newerPageUrl'>
                <span id='blog-pager-newer-link'>
                  <a class='blog-pager-newer-link' expr:href='data:newerPageUrl' expr:id='data:widget.instanceId + "_blog-pager-newer-link"' expr:title='data:newerPageTitle'>&#8592; Newer Posts</a>
                </span>
              </b:if>
              <b:if cond='data:olderPageUrl'>
                <span id='blog-pager-older-link'>
                  <a class='blog-pager-older-link' expr:href='data:olderPageUrl' expr:id='data:widget.instanceId + "_blog-pager-older-link"' expr:title='data:olderPageTitle'>Older Posts &#8594;</a>
                </span>
              </b:if>
              <a class='home-link' expr:href='data:blog.homepageUrl'><data:homeMsg/></a>
            </div>
            <div class='clear'/>
          </b:includable>

          <b:includable id='feedLinks'>
            <b:if cond='data:blog.pageType != "item"'>
              <b:if cond='data:feedLinks'>
                <div class='blog-feeds'>
                  <b:include data='feedLinks' name='feedLinksBody'/>
                </div>
              </b:if>
            <b:else/>
              <div class='post-feeds'>
                <b:loop values='data:posts' var='post'>
                  <b:include cond='data:post.allowComments and data:post.feedLinks' data='post.feedLinks' name='feedLinksBody'/>
                </b:loop>
              </div>
            </b:if>
          </b:includable>

          <b:includable id='feedLinksBody' var='links'>
            <div class='feed-links'>
              <data:feedLinksMsg/>
              <b:loop values='data:links' var='f'>
                <a class='feed-link' expr:href='data:f.url' expr:type='data:f.mimeType' target='_blank'><data:f.name/> (<data:f.feedType/>)</a>
              </b:loop>
            </div>
          </b:includable>

          <b:includable id='status-message'>
            <b:if cond='data:navMessage'>
              <div class='status-msg-wrap'>
                <div class='status-msg-body'><data:navMessage/></div>
                <div style='clear: both;'/>
              </div>
            </b:if>
          </b:includable>

          <b:includable id='mobile-main' var='top'>
            <div class='blog-posts hfeed'>
              <b:include data='top' name='status-message'/>
              <b:if cond='data:blog.pageType == "index"'>
                <b:loop values='data:posts' var='post'>
                  <b:include data='post' name='mobile-index-post'/>
                </b:loop>
              <b:else/>
                <b:loop values='data:posts' var='post'>
                  <b:include data='post' name='mobile-post'/>
                </b:loop>
              </b:if>
            </div>
            <b:include name='mobile-nextprev'/>
          </b:includable>

          <b:includable id='mobile-index-post' var='post'>
            <div class='mobile-date-outer date-outer'>
              <b:if cond='data:post.dateHeader'>
                <div class='date-header'><span><data:post.dateHeader/></span></div>
              </b:if>
              <div class='mobile-post-outer'>
                <a expr:href='data:post.url'>
                  <h3 class='mobile-index-title entry-title' itemprop='name'><data:post.title/></h3>
                  <div class='mobile-index-arrow'>&rsaquo;</div>
                  <div class='mobile-index-contents'>
                    <b:if cond='data:post.thumbnailUrl'>
                      <div class='mobile-index-thumbnail'>
                        <div class='Image'>
                          <img expr:src='data:post.thumbnailUrl'/>
                        </div>
                      </div>
                    </b:if>
                    <div class='post-body'>
                      <b:if cond='data:post.snippet'><data:post.snippet/></b:if>
                    </div>
                  </div>
                  <div style='clear: both;'/>
                </a>
                <div class='mobile-index-comment'>
                  <b:include cond='data:blog.pageType != "static_page" and data:post.allowComments and data:post.numComments != 0' data='post' name='comment_count_picker'/>
                </div>
              </div>
            </div>
          </b:includable>

          <b:includable id='mobile-post' var='post'>
            <div class='date-outer'>
              <b:if cond='data:post.dateHeader'>
                <h2 class='date-header'><span><data:post.dateHeader/></span></h2>
              </b:if>
              <div class='date-posts'>
                <div class='post-outer'>
                  <div class='post hentry uncustomized-post-template' itemscope='itemscope' itemtype='http://schema.org/BlogPosting'>
                    <a expr:name='data:post.id'/>
                    <b:if cond='data:post.title'>
                      <h3 class='post-title entry-title' itemprop='name'>
                        <b:if cond='data:post.link'>
                          <a expr:href='data:post.link'><data:post.title/></a>
                        <b:elseif cond='data:post.url and data:blog.url != data:post.url'/>
                          <a expr:href='data:post.url'><data:post.title/></a>
                        <b:else/>
                          <data:post.title/>
                        </b:if>
                      </h3>
                    </b:if>
                    <div class='post-body entry-content' expr:id='&quot;post-body-&quot; + data:post.id' itemprop='articleBody'>
                      <data:post.body/>
                      <div style='clear: both;'/>
                    </div>
                    <b:include cond='data:blog.pageType in {"static_page","item"}' data='post' name='comment_picker'/>
                  </div>
                </div>
              </div>
            </div>
          </b:includable>

          <b:includable id='mobile-nextprev'>
            <div class='blog-pager' id='blog-pager'>
              <b:if cond='data:newerPageUrl'>
                <div class='mobile-link-button' id='blog-pager-newer-link'>
                  <a class='blog-pager-newer-link' expr:href='data:newerPageUrl' expr:id='data:widget.instanceId + "_blog-pager-newer-link"' expr:title='data:newerPageTitle'>&lsaquo;</a>
                </div>
              </b:if>
              <b:if cond='data:olderPageUrl'>
                <div class='mobile-link-button' id='blog-pager-older-link'>
                  <a class='blog-pager-older-link' expr:href='data:olderPageUrl' expr:id='data:widget.instanceId + "_blog-pager-older-link"' expr:title='data:olderPageTitle'>&rsaquo;</a>
                </div>
              </b:if>
              <div class='mobile-link-button' id='blog-pager-home-link'>
                <a class='home-link' expr:href='data:blog.homepageUrl'><data:homeMsg/></a>
              </div>
              <div class='mobile-desktop-link'>
                <a class='home-link' expr:href='data:desktopLinkUrl'><data:desktopLinkMsg/></a>
              </div>
            </div>
            <div class='clear'/>
          </b:includable>

        </b:widget>
      </b:section>
    </main>

    <!-- ====== SIDEBAR ====== -->
    <aside class='sidebar-main'>
      <b:section class='sidebar' id='sidebar-right-1' name='Sidebar' preferred='yes' showaddelement='yes'>
        <b:widget id='BlogSearch1' locked='false' title='Search Travel Guides' type='BlogSearch'>
          <b:includable id='main'>
            <b:if cond='data:title != ""'><h2><data:title/></h2></b:if>
            <div class='widget-content'>
              <div expr:id='data:widget.instanceId + "_form"'>
                <form class='gsc-search-box' expr:action='data:blog.searchUrl'>
                  <b:attr cond='not data:view.isPreview' name='target' value='_top'/>
                  <input autocomplete='off' class='gsc-input' expr:value='data:view.isSearch ? data:view.search.query.escaped : ""' name='q' placeholder='Search destinations, heritage...' size='10' title='search' type='text'/>
                  <input class='gsc-search-button' expr:value='data:messages.search' title='search' type='submit'/>
                </form>
              </div>
            </div>
            <b:include name='quickedit'/>
          </b:includable>
        </b:widget>

        <b:widget id='PopularPosts1' locked='false' title='Popular Destinations' type='PopularPosts'>
          <b:widget-settings>
            <b:widget-setting name='numItemsToShow'>5</b:widget-setting>
            <b:widget-setting name='showThumbnails'>true</b:widget-setting>
            <b:widget-setting name='showSnippets'>false</b:widget-setting>
            <b:widget-setting name='timeRange'>LAST_YEAR</b:widget-setting>
          </b:widget-settings>
          <b:includable id='main'>
            <b:if cond='data:title != ""'><h2><data:title/></h2></b:if>
            <div class='widget-content popular-posts'>
              <ul>
                <b:loop values='data:posts' var='post'>
                  <li>
                    <div class='item-content'>
                      <b:if cond='data:post.featuredImage.isResizable or data:post.thumbnail'>
                        <div class='item-thumbnail'>
                          <a expr:href='data:post.href' target='_blank'>
                            <b:with value='data:post.featuredImage.isResizable ? resizeImage(data:post.featuredImage, 72, "1:1") : data:post.thumbnail' var='image'>
                              <img alt='' border='0' expr:src='data:image'/>
                            </b:with>
                          </a>
                        </div>
                      </b:if>
                      <div class='item-title'><a expr:href='data:post.href'><data:post.title/></a></div>
                    </div>
                    <div style='clear: both;'/>
                  </li>
                </b:loop>
              </ul>
              <b:include name='quickedit'/>
            </div>
          </b:includable>
        </b:widget>

        <b:widget id='Label1' locked='false' title='Explore by Category' type='Label'>
          <b:widget-settings>
            <b:widget-setting name='sorting'>ALPHA</b:widget-setting>
            <b:widget-setting name='display'>LIST</b:widget-setting>
            <b:widget-setting name='showFreqNumbers'>false</b:widget-setting>
          </b:widget-settings>
          <b:includable id='main'>
            <b:if cond='data:title != ""'><h2><data:title/></h2></b:if>
            <div expr:class='&quot;widget-content &quot; + data:display + &quot;-label-widget-content&quot;'>
              <b:if cond='data:display == "list"'>
                <ul>
                  <b:loop values='data:labels' var='label'>
                    <li>
                      <b:if cond='data:blog.url == data:label.url'>
                        <span expr:dir='data:blog.languageDirection'><data:label.name/></span>
                      <b:else/>
                        <a expr:dir='data:blog.languageDirection' expr:href='data:label.url'><data:label.name/></a>
                      </b:if>
                      <b:if cond='data:showFreqNumbers'>
                        <span dir='ltr'>(<data:label.count/>)</span>
                      </b:if>
                    </li>
                  </b:loop>
                </ul>
              <b:else/>
                <b:loop values='data:labels' var='label'>
                  <span expr:class='&quot;label-size label-size-&quot; + data:label.cssSize'>
                    <a expr:dir='data:blog.languageDirection' expr:href='data:label.url'><data:label.name/></a>
                  </span>
                </b:loop>
              </b:if>
              <b:include name='quickedit'/>
            </div>
          </b:includable>
        </b:widget>

        <b:widget id='Profile1' locked='false' title='About Travel Indias Heritage' type='Profile'>
          <b:widget-settings>
            <b:widget-setting name='showaboutme'>true</b:widget-setting>
            <b:widget-setting name='showlocation'>false</b:widget-setting>
          </b:widget-settings>
          <b:includable id='main'>
            <b:if cond='data:title != ""'><h2><data:title/></h2></b:if>
            <div class='widget-content'>
              <b:if cond='data:photo.url != ""'>
                <a expr:href='data:userUrl'><img class='profile-img' expr:alt='data:messages.myPhoto' expr:height='data:photo.height' expr:src='data:photo.url' expr:width='data:photo.width'/></a>
              </b:if>
              <dl class='profile-datablock'>
                <dt class='profile-data'>
                  <a class='profile-name-link g-profile' expr:href='data:userUrl' rel='author'><data:displayname/></a>
                </dt>
                <b:if cond='data:aboutme != ""'><dd class='profile-textblock'><data:aboutme/></dd></b:if>
              </dl>
              <b:include name='quickedit'/>
            </div>
          </b:includable>
        </b:widget>

        <b:widget id='BlogArchive1' locked='false' title='Archive' type='BlogArchive'>
          <b:widget-settings>
            <b:widget-setting name='showStyle'>FLAT</b:widget-setting>
            <b:widget-setting name='frequency'>MONTHLY</b:widget-setting>
            <b:widget-setting name='chronological'>false</b:widget-setting>
          </b:widget-settings>
          <b:includable id='main'>
            <b:if cond='data:title != ""'><h2><data:title/></h2></b:if>
            <div class='widget-content'>
              <div id='ArchiveList'>
                <div expr:id='data:widget.instanceId + "_ArchiveList"'>
                  <b:include cond='data:style == "FLAT"' data='data' name='flat'/>
                </div>
              </div>
              <b:include name='quickedit'/>
            </div>
          </b:includable>
          <b:includable id='flat' var='data'>
            <ul class='flat'>
              <b:loop values='data:data' var='i'>
                <li class='archivedate'>
                  <a expr:href='data:i.url'><data:i.name/></a> (<data:i.post-count/>)
                </li>
              </b:loop>
            </ul>
          </b:includable>
        </b:widget>
      </b:section>
    </aside>
  </div>

